# Qoneqt AI Content Pipeline Environment Variables
PORT=8000
HOST=0.0.0.0
FRONTEND_PORT=3000

# LLM Configuration (e.g., Gemini)
GEMINI_API_KEY=

# Image Generation Configuration
IMAGE_PROVIDER=mock
# Optional: STABILITY_API_KEY, OPENAI_API_KEY, etc.

# TTS Configuration
TTS_PROVIDER=edge-tts
# Options: edge-tts, piper, mock

# Video Configuration
OUTPUT_DIR=generated/videos

# Qoneqt API (when official credentials / endpoints are provided)
QONEQT_API_URL=
QONEQT_API_KEY=
